      }
    },
    "Coach reads a summary of your last two weeks plus 30-day averages and recent workouts, then answers in plain language. Try a suggestion below.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Coach reads a summary of your last two weeks plus 30-day averages and recent workouts, then answers in plain language. Try a suggestion below." } },
        "de": { "stringUnit": { "state": "translated", "value": "Der Coach liest eine Zusammenfassung deiner letzten zwei Wochen sowie 30-Tage-Durchschnitte und aktuelle Workouts und antwortet dann in klarer Sprache. Probiere einen Vorschlag unten aus." } },
        "es": { "stringUnit": { "state": "translated", "value": "El Entrenador lee un resumen de tus últimas dos semanas, además de los promedios de 30 días y entrenamientos recientes, y te responde con claridad. Prueba con una sugerencia abajo." } }
      }
    },
    "Coach said: %@": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Coach said: %@" } },
        "de": { "stringUnit": { "state": "translated", "value": "Coach sagte: %@" } },
        "es": { "stringUnit": { "state": "translated", "value": "El Entrenador dijo: %@" } }
      }
    },
    "Coach uses your own API key. Pick a provider, paste a key, and choose a model. Your key is stored securely in the macOS Keychain and never leaves your Mac except as the request you make.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Coach uses your own API key. Pick a provider, paste a key, and choose a model. Your key is stored securely in the macOS Keychain and never leaves your Mac except as the request you make." } },
        "de": { "stringUnit": { "state": "translated", "value": "Der Coach nutzt deinen eigenen API-Schlüssel. Wähle einen Anbieter, füge einen Schlüssel ein und wähle ein Modell. Dein Schlüssel wird sicher im macOS-Schlüsselbund gespeichert und verlässt deinen Mac nur als die Anfrage, die du stellst." } },
        "es": { "stringUnit": { "state": "translated", "value": "El Entrenador usa tu propia API key. Elige un proveedor, pega una clave y elige un modelo. Tu clave se guarda de forma segura en el Llavero de macOS y nunca sale de tu Mac, excepto en la propia petición." } }
      }
    },
