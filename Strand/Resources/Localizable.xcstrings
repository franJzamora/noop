    "Off — the coach answers generally and sends none of your metrics.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Off — the coach answers generally and sends none of your metrics." } },
        "de": { "stringUnit": { "state": "translated", "value": "Aus — der Coach antwortet allgemein und sendet keine deiner Metriken." } },
        "es": { "stringUnit": { "state": "translated", "value": "Desactivado — el Entrenador responde de manera general y no envía ninguna de tus métricas." } }
      }
    },
    "OK": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "OK" } },
        "de": { "stringUnit": { "state": "translated", "value": "OK" } },
        "es": { "stringUnit": { "state": "translated", "value": "OK" } }
      }
    },
    "On — your recovery, sleep, HRV and workouts are shared with the provider for tailored coaching.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "On — your recovery, sleep, HRV and workouts are shared with the provider for tailored coaching." } },
        "de": { "stringUnit": { "state": "translated", "value": "An — deine Erholung, dein Schlaf, deine HRV und Workouts werden für maßgeschneidertes Coaching mit dem Anbieter geteilt." } },
        "es": { "stringUnit": { "state": "translated", "value": "Activado — tu recuperación, sueño, VFC y entrenamientos se comparten con el proveedor para un entrenamiento personalizado." } }
      }
    },
    "On a 5/MG connection NOOP will send a puffin realtime-stream request after the handshake, and log what comes back. If you have a 5/MG strap, turning this on and sharing your strap log helps map the protocol. No effect on WHOOP 4.0.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "On a 5/MG connection NOOP will send a puffin realtime-stream request after the handshake, and log what comes back. If you have a 5/MG strap, turning this on and sharing your strap log helps map the protocol. No effect on WHOOP 4.0." } },
        "de": { "stringUnit": { "state": "translated", "value": "Bei einer 5/MG-Verbindung sendet NOOP nach dem Handshake eine Puffin-Echtzeitstream-Anfrage und protokolliert die Antwort. Wenn du einen 5/MG-Strap hast, hilft das Aktivieren und Teilen deines Strap-Protokolls, das Protokoll zu kartieren. Keine Auswirkung auf WHOOP 4.0." } },
        "es": { "stringUnit": { "state": "translated", "value": "En una conexión 5/MG, NOOP enviará una petición de puffin realtime-stream tras el handshake y registrará lo que reciba. Si tienes una pulsera 5/MG, activar esto y compartir el registro de la pulsera ayuda a mapear el protocolo. No afecta a WHOOP 4.0." } }
      }
    },
    "Open-source BLE reverse-engineering work. Thank you.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Open-source BLE reverse-engineering work. Thank you." } },
        "de": { "stringUnit": { "state": "translated", "value": "Open-Source-BLE-Reverse-Engineering-Arbeit. Danke." } },
        "es": { "stringUnit": { "state": "translated", "value": "Trabajo de ingeniería inversa BLE open-source. Gracias." } }
      }
    },
    "Opens the GitHub releases page in your browser. NOOP itself makes no network connections — the macOS sandbox has no network entitlement.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Opens the GitHub releases page in your browser. NOOP itself makes no network connections — the macOS sandbox has no network entitlement." } },
