    "These power your heart-rate zones, calorie estimates and recovery baselines. Keep them accurate.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "These power your heart-rate zones, calorie estimates and recovery baselines. Keep them accurate." } },
        "de": { "stringUnit": { "state": "translated", "value": "Diese steuern deine Herzfrequenzzonen, Kalorienschätzungen und Erholungs-Basislinien. Halte sie genau." } },
        "es": { "stringUnit": { "state": "translated", "value": "Estas métricas alimentan tus zonas de frecuencia cardíaca, cálculo de calorías y líneas base de recuperación. Mantenlas precisas." } }
      }
    },
    "Thinking": {
      "localizations": {
