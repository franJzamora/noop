    "Estimate only — a higher RMSSD while paced usually means your parasympathetic \"rest\" branch is engaging. It is not a clinical reading; trends over a session matter more than any single number.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Estimate only — a higher RMSSD while paced usually means your parasympathetic \"rest\" branch is engaging. It is not a clinical reading; trends over a session matter more than any single number." } },
        "de": { "stringUnit": { "state": "translated", "value": "Nur eine Schätzung — ein höherer RMSSD beim getakteten Atmen bedeutet meist, dass dein parasympathischer \"Ruhe\"-Zweig aktiv wird. Es ist kein klinischer Wert; Trends über eine Sitzung sind wichtiger als ein einzelner Wert." } },
        "es": { "stringUnit": { "state": "translated", "value": "Solo estimación — un RMSSD mayor durante la respiración guiada normalmente indica que la rama parasimpática de \"descanso\" se está activando. No es una lectura clínica; las tendencias a lo largo de una sesión importan más que un número individual." } }
      }
    },
    "Estimated max heart rate · %lld bpm": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Estimated max heart rate · %lld bpm" } },
        "de": { "stringUnit": { "state": "translated", "value": "Geschätzte maximale Herzfrequenz · %lld bpm" } },
        "es": { "stringUnit": { "state": "translated", "value": "Frecuencia cardíaca máx. estimada · %lld lpm" } }
      }
    },
    "Every beat, every night, every day — woven into one quiet picture of you. Welcome to NOOP.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Every beat, every night, every day — woven into one quiet picture of you. Welcome to NOOP." } },
        "de": { "stringUnit": { "state": "translated", "value": "Jeder Schlag, jede Nacht, jeder Tag — verwoben zu einem ruhigen Bild von dir. Willkommen bei NOOP." } },
        "es": { "stringUnit": { "state": "translated", "value": "Cada latido, cada noche, cada día — tejidos en una imagen clara de ti. Te damos la bienvenida a NOOP." } }
      }
    },
    "Every session, threaded together.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Every session, threaded together." } },
        "de": { "stringUnit": { "state": "translated", "value": "Jede Sitzung, miteinander verwoben." } },
        "es": { "stringUnit": { "state": "translated", "value": "Cada sesión, enlazada." } }
      }
