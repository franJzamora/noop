        "es": { "stringUnit": { "state": "translated", "value": "Importar…" } }
      }
    },
    "Importing overwrites everything currently on this Mac. Your old data is kept in a side file just in case. NOOP needs a relaunch for an import to take effect.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Importing overwrites everything currently on this Mac. Your old data is kept in a side file just in case. NOOP needs a relaunch for an import to take effect." } },
        "de": { "stringUnit": { "state": "translated", "value": "Der Import überschreibt alles, was sich derzeit auf diesem Mac befindet. Deine alten Daten werden sicherheitshalber in einer separaten Datei aufbewahrt. NOOP muss neu gestartet werden, damit ein Import wirksam wird." } },
        "es": { "stringUnit": { "state": "translated", "value": "Al importar se sobrescribe todo lo que hay actualmente en este Mac. Tus datos antiguos se guardan en un archivo de respaldo por si acaso. NOOP necesita reiniciarse para que la importación surta efecto." } }
      }
    },
