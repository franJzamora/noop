    "No data for these metrics in %@. Widen the range or pick metrics you've logged.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "No data for these metrics in %@. Widen the range or pick metrics you've logged." } },
        "de": { "stringUnit": { "state": "translated", "value": "Keine Daten für diese Metriken in %@. Erweitere den Bereich oder wähle Metriken, die du erfasst hast." } },
        "es": { "stringUnit": { "state": "translated", "value": "No hay datos para estas métricas en %@. Amplía el rango o elige métricas que hayas registrado." } }
      }
    },
    "No nights here yet. Import your WHOOP export in Data Sources to see every night, your sleep stages and trends straight away. Or open Intelligence to see last night computed from the strap after you wear it to bed.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "No nights here yet. Import your WHOOP export in Data Sources to see every night, your sleep stages and trends straight away. Or open Intelligence to see last night computed from the strap after you wear it to bed." } },
        "de": { "stringUnit": { "state": "translated", "value": "Noch keine Nächte hier. Importiere deinen WHOOP-Export unter Datenquellen, um sofort jede Nacht, deine Schlafphasen und Trends zu sehen. Oder öffne Intelligenz, um die letzte Nacht aus dem Strap berechnet zu sehen, nachdem du ihn nachts getragen hast." } },
        "es": { "stringUnit": { "state": "translated", "value": "Aún no hay noches aquí. Importa tu exportación de WHOOP en Orígenes de datos para ver todas las noches, tus fases de sueño y tendencias al instante. O abre Inteligencia para ver el cálculo de anoche desde la pulsera después de dormir con ella." } }
      }
    },
