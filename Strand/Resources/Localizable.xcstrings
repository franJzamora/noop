    "Recovery": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Recovery" } },
        "de": { "stringUnit": { "state": "translated", "value": "Erholung" } },
        "es": { "stringUnit": { "state": "translated", "value": "Recuperación" } }
      }
    },
    "Recovery weighs your HRV against your personal baseline (~60%), resting heart rate (~20%), sleep performance (~15%) and respiration (~5%). Day strain is a 0–21 cardiovascular load from time in heart-rate zones. Sleep is staged from movement and heart rate. Everything is computed here from the strap's raw data — it works for any day NOOP collected raw streams.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Recovery weighs your HRV against your personal baseline (~60%), resting heart rate (~20%), sleep performance (~15%) and respiration (~5%). Day strain is a 0–21 cardiovascular load from time in heart-rate zones. Sleep is staged from movement and heart rate. Everything is computed here from the strap's raw data — it works for any day NOOP collected raw streams." } },
        "de": { "stringUnit": { "state": "translated", "value": "Die Erholung gewichtet deine HRV gegenüber deiner persönlichen Basislinie (~60 %), die Ruheherzfrequenz (~20 %), die Schlafleistung (~15 %) und die Atmung (~5 %). Die Tagesbelastung ist eine kardiovaskuläre Last von 0–21 aus der Zeit in Herzfrequenzzonen. Der Schlaf wird aus Bewegung und Herzfrequenz in Phasen eingeteilt. Alles wird hier aus den Rohdaten des Straps berechnet — es funktioniert für jeden Tag, an dem NOOP Rohdaten erfasst hat." } },
        "es": { "stringUnit": { "state": "translated", "value": "La Recuperación evalúa tu VFC respecto a tu línea base personal (~60%), FC en reposo (~20%), rendimiento del sueño (~15%) y respiración (~5%). El esfuerzo del día es una carga cardiovascular de 0-21 según el tiempo en zonas de frecuencia cardíaca. Las fases de sueño se basan en el movimiento y la FC. Todo se calcula aquí desde los datos en crudo de la pulsera — funciona para cualquier día en el que NOOP haya recogido datos." } }
      }
    },
